# Local fixture mode defaults
USE_CLICKHOUSE=false
USE_AGENT_FIXTURES=true
USE_TEMPORAL=false
DEMO_MODE=true

# App settings
BASE_DOMAIN=fastaisolution.com
TEMPORAL_TASK_QUEUE=launch-store
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_MINUTES=10080

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCKS=false

# Temporal Cloud / server settings
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# Gemini / Google ADK
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Nimble
NIMBLE_API_KEY=

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Datadog
DATADOG_API_KEY=
DATADOG_SITE=

# Optional DNS cleanup only; not required for demo path
GODADDY_API_KEY=
GODADDY_API_SECRET=

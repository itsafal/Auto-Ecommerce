# Local fixture mode defaults.
#
# USE_CLICKHOUSE=true is the team default so every dev's runs show up in
# the shared dashboard. To use it you MUST also set the CLICKHOUSE_* vars
# below — ask the team chat for the cloud credentials. If you only need
# to run tests or work offline, flip USE_CLICKHOUSE=false.
USE_CLICKHOUSE=true
USE_AGENT_FIXTURES=true
USE_TEMPORAL=false
DEMO_MODE=true

# App settings
# Per-agent delay for live progress streaming (0 = run synchronously, no streaming)
AGENT_STREAM_DELAY_MS=1200
BASE_DOMAIN=fastaisolution.com
TEMPORAL_TASK_QUEUE=launch-store
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_MINUTES=10080
REQUIRE_AUTH_FOR_RUNS=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCKS=false

# Temporal Cloud / server settings
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# Gemini / Google ADK
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Portkey gateway for Gemini. Preferred when PORTKEY_API_KEY is set.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://ai-gateway.apps.cloud.rt.nyu.edu/v1
PORTKEY_MODEL=@vertexai/gemini-3.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Which LLM provider to use. "auto" tries portkey → anthropic → gemini in order
# based on which key is set. Override with "anthropic" | "portkey" | "gemini"
# to force a single provider regardless of other keys present.
LLM_PROVIDER=auto

# Nimble
NIMBLE_API_KEY=
NIMBLE_API_URL=

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_SECURE=true

# Datadog
DATADOG_API_KEY=
DATADOG_SITE=

# Optional DNS cleanup only; not required for demo path
GODADDY_API_KEY=
GODADDY_API_SECRET=
